{
  "name": "@deepseek-ai/dsh-tool-db",
  "description": "Model-facing database query tools over PostgreSQL, MySQL, and SQLite via DATABASE_URL",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/dsh-system-prompt": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "optionalDependencies": {
    "postgres": "^3.4.5",
    "better-sqlite3": "^11.7.0",
    "mysql2": "^3.12.0",
    "oracledb": "^6.7.0",
    "mssql": "^11.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/dsh-system-prompt": "workspace:*",
    "@types/better-sqlite3": "^7.6.12"
  }
}
